{
  "name": "flowai-organic-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de crescimento orgânico da FlowAI Digital — pesquisa, valida, prioriza, cria, revisa, publica, indexa, mede e aprende.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/!(integration).test.mjs\"",
    "health": "node src/cli.mjs health --verify",
    "gates": "node src/cli.mjs gates",
    "test:integration": "node --test --test-force-exit test/integration.test.mjs",
    "test:all": "npm test && npm run test:integration",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "crawlers": "node src/cli.mjs crawlers"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "pg-boss": "^10.3.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5"
  }
}
